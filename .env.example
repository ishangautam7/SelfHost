# SelfHost Server Configuration — COPY THIS TO .env

# Server
HOST=0.0.0.0
PORT=8080

# PostgreSQL
DATABASE_URL=postgresql://selfhost:change-me@localhost:5432/selfhost

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=

# Domain — your base domain for subdomains
BASE_DOMAIN=selfhost.ishangautam7.com.np

# Agent connection details returned by /api/agent/config
SERVER_HOST=api.ishangautam7.com.np
SERVER_PORT=443
USE_TLS=true

# Frontend (exposed to the browser at build time)
NEXT_PUBLIC_API_URL=https://api.ishangautam7.com.np
NEXT_PUBLIC_BASE_DOMAIN=selfhost.ishangautam7.com.np
